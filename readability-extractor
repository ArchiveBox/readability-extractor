#!/usr/bin/env node
/*
readability-extractor
MIT License
https://github.com/ArchiveBox/readability-extractor

Usage:
  ./readability-extractor ./archive/12345678910/singlefile.html 'https://example.com/original/url.html' 'utf-8' > article.json
*/

const source_path = process.argv[2]                                                            // e.g. ./archive/12345678910/singlefile.html
const original_url = process.argv[3] || "https://example.com/url-not-specified"                // e.g. https://exmaple.com/some/page.html
const encoding_hint = process.argv[4] || null                                                  // e.g. utf-8 or windows-1252

// don't importing anything before this point to avoid erroring for missing dependencies during version query
if (process.argv.includes("--version")) {
    const package_info = require('./package.json')
    console.log(package_info.version)   // e.g. 1.0.0
    process.exit(0)
}

function getArticle(html) {
  const createDOMPurify = require('dompurify')
  const { Readability } = require('@mozilla/readability')
  const { JSDOM } = require('jsdom')

  const window = new JSDOM('').window

  // strip potential XSS/JS in the article using DOMPurify library
  const DOMPurify = createDOMPurify(window)
  const cleaned_html = DOMPurify.sanitize(html)
  const cleaned_dom = new JSDOM(cleaned_html, {url: original_url})

  // Readability turns BR chains into paragraphs, including inside PRE. Saved
  // syntax-highlighted DOM uses those breaks for code lines and blank lines.
  for (const br of cleaned_dom.window.document.querySelectorAll('pre br')) {
    br.replaceWith(cleaned_dom.window.document.createTextNode('\n'))
  }
  
  // parse out the Article body text using Readability library
  const reader = new Readability(cleaned_dom.window.document)
  const article = reader.parse()

  // check for parse failure
  if (!article) {
    throw 'Readability was unable to parse article text from this HTML'
  }

  // Strip leading and trailing whitespace
  if (article['textContent'] !== null) {
      article['textContent'] = article['textContent'].trim()
  }

  // Attach information about original source charset to output
  const charset = cleaned_dom.window.document.characterSet
  article['charset'] = charset
  
  if (article['content'] !== null && charset !== 'windows-1252') {
      // prepend meta charset tag to html to hint to downstream renderers to use the correct original encoding
      article['content'] = `<meta charset="${charset}">\n${article['content']}`
  }
  return article
}

const fs = require('fs')

fs.readFile(source_path, function(err, data) {
    if (err) throw err;

    // Strip byte-heavy payloads before UTF-8 decoding: one character outside Latin-1
    // otherwise widens the entire base64-heavy document to a two-byte string.
    let html = data.toString('latin1')
    data = null

    // JSDOM allocates far more memory than an inline payload's source size.
    // Apply the existing large-document safeguard before parsing, including
    // individual oversized images in otherwise small documents. Keep ordinary
    // inline images; the original capture remains the full-fidelity resource.
    const stripAllInlineImages = html.length > 14_000_000
    const maxInlineImageSize = 1024 * 1024
    const replacement = 'data:image/png;base64,inline-images-stripped-by-archivebox-because-size-limit-exceeded=='
    let strippedDataURLs = 0
    const replaceDataURL = (url) => {
      if ((stripAllInlineImages && /^data:[^,]*;base64,/i.test(url)) || url.length > maxInlineImageSize) {
        strippedDataURLs++
        return replacement
      }
      return url
    }

    // Wrapped base64 can contain whitespace, but generic quoted URLs cannot:
    // a srcset value may contain more candidates that must not be discarded.
    // Matching quotes allow opposite quotes and parentheses inside SVG URLs;
    // only unquoted CSS url(...) values end at a parenthesis. Explicit
    // delimiters avoid the old wildcard regex's unbounded backtracking.
    const header = String.raw`data:[^,\s"'<>:]*,`
    const base64 = String.raw`data:[^,\s"'<>:]*;base64,[A-Za-z0-9+/=\s]+`
    const dataURLs = new RegExp(String.raw`"(${base64}|${header}[^"\s<>]+)"|'(${base64}|${header}[^'\s<>]+)'|\b(url\(\s*)(${header}[^\s"'<>)]*)|(?<![\w:-])(${header}[^\s"'<>]+)`, 'gi')
    html = html.replace(dataURLs,
      (match, doubleQuoted, singleQuoted, cssPrefix, cssURL, bare) => {
        const url = doubleQuoted || singleQuoted || cssURL || bare
        const replaced = replaceDataURL(url)
        const quote = doubleQuoted ? '"' : singleQuoted ? "'" : ''
        return replaced === url ? match : quote ? quote + replaced + quote : (cssPrefix || '') + replaced
      })
    html = Buffer.from(html, 'latin1').toString('utf8')
    if (strippedDataURLs) console.warn(`[!] WARNING: Stripped ${strippedDataURLs} inline data URLs exceeding extraction size limits`)

    article = getArticle(html)

    console.log(JSON.stringify(article, null, 4))
});
